{
  "name": "spinner-cockpit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 4186 --strictPort",
    "build": "vite build",
    "build:pages": "vite build --base=/SpinnerCockpit/ --outDir docs --emptyOutDir && node scripts/finish-pages-build.mjs",
    "preview:pages": "vite preview --outDir docs --base=/SpinnerCockpit/ --host localhost --port 4187 --strictPort",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cesium": "1.138.0",
    "gods-eye-view": "git+https://github.com/polerix/gods-eye-view.git#main"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "overrides": {
    "@cesium/engine": "22.3.0",
    "@cesium/widgets": "14.3.0"
  }
}
